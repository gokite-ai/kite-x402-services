# Wallet that receives payments. Use the receive address shown by
# `kpass wallet address` or any EOA you control on the Kite chain.
PAY_TO=0x60B9d2ef6D045CDEfa49D82115fA2BA4Ac949022

# mainnet (USDC.e on eip155:2366) or testnet (pieUSD on eip155:2368)
KITE_NETWORK=mainnet

# The API being wrapped. /v1/<path> on this service proxies to UPSTREAM_URL/<path>.
# Frankfurter keeps the /v1 prefix on its own routes, so point UPSTREAM_URL at
# the host root and let /v1/... pass straight through.
UPSTREAM_URL=https://api.frankfurter.dev
# Frankfurter needs no credential; leave the auth value empty.
UPSTREAM_AUTH_HEADER=Authorization
UPSTREAM_AUTH_VALUE=

# Price per call in USD, charged in the network's stablecoin.
PRICE_USD=0.001
SERVICE_DESCRIPTION=Frankfurter ECB foreign-exchange rates behind x402 on Kite

PORT=8080
# FACILITATOR_URL=https://facilitator.pieverse.io/v2
